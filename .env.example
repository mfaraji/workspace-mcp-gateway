# Postgres connection (SQLAlchemy psycopg3 driver).
# Local dev uses a dedicated role/db on the host Postgres:
DATABASE_URL=postgresql+psycopg://workspace_mcp:wmcp_local_dev_pw@127.0.0.1:5432/workspace_mcp

# Public base URL of the gateway. Used to derive the OAuth redirect URI:
#   {BASE_URL}/oauth/google/callback
BASE_URL=http://localhost:8000

# Google OAuth client (Web application) credentials.
GOOGLE_CLIENT_ID=replace-me.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=replace-me

# Apex invoicing/timesheet API. Each user stores their own key with the
# apex_set_api_key tool (or POST /connectors/apex/apikey) — see
# docs/api/invoice-rest.openapi.yaml in the apex repo. APEX_API_KEY and
# APEX_WEALTH_API_KEY below are DEPRECATED and ignored (no deploy-wide fallback;
# per-user keys, and later Clerk act-as via APEX_GATEWAY_API_KEY, replace them).
# They remain only so existing .env files still parse.
APEX_BASE_URL=http://localhost:3010
APEX_API_KEY=
# DEPRECATED and ignored; users store their own with apex_wealth_set_api_key.
APEX_WEALTH_API_KEY=
# Act-as: system API key minted in Apex with scripts/create-gateway-api-key.ts
# (consumer GATEWAY). With it set (and CLERK_ISSUER), Clerk-signed-in users reach
# Apex as themselves without pasting a key; they pick a default workspace with
# apex_list_workspaces / apex_set_workspace. Leave unset to disable act-as. Secret.
APEX_GATEWAY_API_KEY=

# Telegram bot tokens are submitted per user through Open WebUI Settings,
# validated by the private /api/telegram routes, and encrypted in PostgreSQL.
# There is intentionally no deployment-wide Telegram token fallback.

# Fernet key for encrypting provider tokens at rest. Generate with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
TOKEN_ENCRYPTION_KEY=replace-me-with-a-fernet-key

# Trusted Open WebUI origin. Defense-in-depth only (no longer the trust gate);
# retained for optional logging. Set to the public URL of the gateway.
TRUSTED_OPEN_WEBUI_ORIGIN=http://localhost:8000

# Secret for signing session cookies and OAuth state tokens.
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
SESSION_SECRET=replace-me-with-a-random-secret

# Required Clerk issuer and confidential browser OAuth application.
# Register callback {BASE_URL}/access/callback, enable authorization code + PKCE,
# mcp:tools scope, and audience-bound access tokens for /mcp and each product mount.
CLERK_ISSUER=
# Native OAuth consent is served by the gateway at /oauth/consent.
# Backend key stays server-side and validates registered clients and redirects.
CLERK_PUBLISHABLE_KEY=
CLERK_BACKEND_API_KEY=
# Default Clerk browser-session audience, if configured in Clerk session claims.
CLERK_SESSION_AUDIENCE=
CLERK_BROWSER_CLIENT_ID=
CLERK_BROWSER_CLIENT_SECRET=

# Couchbase Capella document storage (optional; used by the recipes connector).
# Leave unset to run without it: recipe tools then return storage_not_configured
# and every other connector is unaffected. TLS is mandatory (couchbases://).
# Use a database credential with Read/Write on bucket `personal`, scope `recipes`
# only. See docs/recipes-capella.md for setup, IP allowlisting and indexes.
CAPELLA_CONNECTION_STRING=
CAPELLA_USERNAME=
CAPELLA_PASSWORD=
CAPELLA_BUCKET=personal
CAPELLA_RECIPES_SCOPE=recipes
CAPELLA_RECIPES_COLLECTION=recipes
# Optional timeouts in seconds.
# CAPELLA_CONNECT_TIMEOUT_SECONDS=10
# CAPELLA_KV_TIMEOUT_SECONDS=5
# CAPELLA_QUERY_TIMEOUT_SECONDS=15
