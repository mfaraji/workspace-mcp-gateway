# Postgres connection (SQLAlchemy psycopg3 driver).
# Local dev uses a dedicated role/db on the host Postgres:
DATABASE_URL=postgresql+psycopg://workspace_mcp:wmcp_local_dev_pw@127.0.0.1:5432/workspace_mcp

# Public base URL of the gateway. Used to derive the OAuth redirect URI:
#   {BASE_URL}/oauth/google/callback
BASE_URL=http://localhost:8000

# Google OAuth client (Web application) credentials.
GOOGLE_CLIENT_ID=replace-me.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=replace-me

# Apex invoicing/timesheet API. Each user stores their own key with the
# apex_set_api_key tool (or POST /connectors/apex/apikey) — see
# docs/api/invoice-rest.openapi.yaml in the apex repo. APEX_API_KEY below is
# optional: a deploy-wide fallback used only for users who haven't stored a
# personal key yet. Create one with scripts/create-invoice-api-key.ts in that
# repo.
APEX_BASE_URL=http://localhost:3010
APEX_API_KEY=
# Optional fallback for the apex-wealth connector (needs a PERSONAL-workspace key;
# users normally store their own with apex_wealth_set_api_key).
APEX_WEALTH_API_KEY=

# Telegram bot tokens are submitted per user through Open WebUI Settings,
# validated by the private /api/telegram routes, and encrypted in PostgreSQL.
# There is intentionally no deployment-wide Telegram token fallback.

# Fernet key for encrypting provider tokens at rest. Generate with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
TOKEN_ENCRYPTION_KEY=replace-me-with-a-fernet-key

# Shared secret proving a request comes from the trusted Open WebUI deployment.
# Open WebUI must send this as the X-Gateway-Auth header on every MCP request;
# the public reverse proxy strips that header so public callers can't present it.
# This is the gate for header-based identity. Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
GATEWAY_SHARED_SECRET=replace-me-with-a-shared-secret

# Trusted Open WebUI origin. Defense-in-depth only (no longer the trust gate);
# retained for optional logging. Set to the public URL of the gateway.
TRUSTED_OPEN_WEBUI_ORIGIN=http://localhost:8000

# Secret for signing session cookies and OAuth state tokens.
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
SESSION_SECRET=replace-me-with-a-random-secret

# Local-dev only: when "true", plain identity headers are trusted regardless of
# origin so you can exercise the flow without a reverse proxy. NEVER set in prod.
DEV_TRUST_ALL_ORIGINS=false

# Optional Clerk authorization server (HTTPS Frontend API URL). Enable JWT
# access tokens, a custom mcp:tools scope, CIMD client onboarding, and a
# confidential OAuth app for account linking with callback:
#   {BASE_URL}/oauth/clerk/link/callback
# Device-code CLI clients need their own public OAuth app with the Device
# Authorization Grant enabled. Never put that app's secret in a CLI.
CLERK_ISSUER=
CLERK_LINK_CLIENT_ID=
CLERK_LINK_CLIENT_SECRET=
CLERK_LINK_SCOPE=openid profile mcp:tools
